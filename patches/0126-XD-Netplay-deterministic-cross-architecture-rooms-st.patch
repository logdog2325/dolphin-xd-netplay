+bool NetPlayServer::RoomMixesCpuArchitectures()
+{
+  std::lock_guard lkp(m_crit.players);
+  std::optional<std::string> first;
+  for (const auto& p : std::views::values(m_players))
+  {
+    const std::string a = p.arch.empty() ? "other" : p.arch;
+    if (!first)
+      first = a;
+    else if (*first != a)
+      return true;
+  }
+  return false;
+}

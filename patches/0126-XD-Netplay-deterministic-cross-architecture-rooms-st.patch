diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0d5ebfa..6dde3ce 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -318,6 +318,11 @@ else()
 
   # gcc uses some optimizations which might break stuff without this flag
   check_and_add_flag(NO_STRICT_ALIASING -fno-strict-aliasing)
+  # The interpreter cores must produce identical bits on x86_64 and arm64. Apple
+  # and NDK clang default to -ffp-contract=on and FMA is baseline on arm64, so any
+  # a*b+c written as one expression would fuse there and not on x86. Audited
+  # contraction-free today; keep it that way. MSVC /fp:precise never contracts.
+  check_and_add_flag(NO_FP_CONTRACT -ffp-contract=off)
   check_and_add_flag(NO_EXCEPTIONS -fno-exceptions)
 
   check_and_add_flag(VISIBILITY_INLINES_HIDDEN -fvisibility-inlines-hidden)
diff --git a/Source/Core/Common/ArmCPUDetect.cpp b/Source/Core/Common/ArmCPUDetect.cpp
index 91b66f8..e950261 100644
--- a/Source/Core/Common/ArmCPUDetect.cpp
+++ b/Source/Core/Common/ArmCPUDetect.cpp
@@ -234,6 +234,16 @@ void CPUInfo::Detect()
   bSHA1 = true;
   bSHA2 = true;
   bCRC32 = true;
+  // FEAT_AFP (Apple M4 class and later): with it the hardware can flush denormal
+  // outputs only, exactly like the Gekko; without it (M1-M3) FZ also flushes
+  // inputs, which OrreLink's interpreter-core path works around in software.
+  // macOS 12+ exposes it as an int sysctl.
+  {
+    int afp = 0;
+    size_t len = sizeof(afp);
+    if (sysctlbyname("hw.optional.arm.FEAT_AFP", &afp, &len, nullptr, 0) == 0)
+      bAFP = afp != 0;
+  }
 #elif defined(_WIN32)
   // NOTE All this info is from cpu core 0 only.
 

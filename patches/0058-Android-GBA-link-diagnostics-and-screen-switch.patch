+        val deviceCount = LINK_DEVICE_RANGE.count()
+        val current = visibleDeviceNumber
+        val start = if (current in LINK_DEVICE_RANGE) {
+            current - LINK_DEVICE_RANGE.first
+        } else {
+            deviceCount - 1
+        }

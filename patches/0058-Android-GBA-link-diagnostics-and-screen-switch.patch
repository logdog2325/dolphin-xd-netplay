 #include "jni/AndroidCommon/AndroidCommon.h"
 #include "jni/AndroidCommon/IDCache.h"
 
@@ -164,4 +167,47 @@ Java_org_dolphinemu_dolphinemu_features_dualscreen_GbaHostBridge_setVisibleDevic
 {

     const u16 pressed = pad_status.button & ~m_diag_prev_buttons;
     if (pressed & (PAD_BUTTON_A | PAD_BUTTON_B | PAD_BUTTON_START))
     {
-      GBADetectLog::LogEvent(m_device_number,
-                             m_system.GetCoreTiming().GetTicks(), "pad",

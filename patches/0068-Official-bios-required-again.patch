From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: logdog2325 <loganjayfisher@gmail.com>
Date: Wed, 29 Jul 2026 01:06:49 -0700
Subject: [PATCH] The official GBA BIOS is required, and the launchers say so
 again

Three non-official BIOS paths were tested on device and all fail the same
way -- the GBA's link window opens repeatedly while the GameCube never
starts a handshake: the old bundled build, a current Cult-of-GBA build
carrying the RegisterRamReset SIO fix, and mGBA's HLE BIOS.

That rules out the RegisterRamReset theory. What distinguishes the official
dump is that its boot code contains Nintendo's own JoyBus listener, which
answers the GameCube's boot handshake from inside the BIOS. No clean-room
BIOS reimplements it and the HLE BIOS does not either, so no replacement
can stand in for it here.

Restore the requirement in both launchers with text that states the
consequence rather than calling it optional. The bundled image stays at the
current upstream build -- it is not usable for this link either way, but it
is the better of the two open-source images to ship.
---
 .../features/xdnetplay/ui/XDLauncherScreen.kt   | 12 +++---------
 .../DolphinQt/XDNetplay/XDLauncherDialog.cpp    | 17 ++++++++++-------
 2 files changed, 13 insertions(+), 16 deletions(-)

diff --git a/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/features/xdnetplay/ui/XDLauncherScreen.kt b/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/features/xdnetplay/ui/XDLauncherScreen.kt
index d80592a9dd..a8e71d9328 100644
--- a/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/features/xdnetplay/ui/XDLauncherScreen.kt
+++ b/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/features/xdnetplay/ui/XDLauncherScreen.kt
@@ -192,15 +192,9 @@ private fun ReadinessCard(
                 onFix = onOpenSettings
             )
             CheckRow(
-                // Never a blocker: with no BIOS file the GBA boots on the
-                // emulator's built-in HLE BIOS, which XD detects.
-                ok = true,
-                okText = if (biosLinkReady) {
-                    "GBA BIOS: using your official dump"
-                } else {
-                    "GBA BIOS: none needed — booting without one (optional)"
-                },
-                missingText = "",
+                ok = biosLinkReady,
+                okText = "Official GBA BIOS configured",
+                missingText = "Official GBA BIOS required — the game cannot detect the GBA without it",
                 fixLabel = "Choose BIOS…",
                 onFix = onPickGbaBios
             )
diff --git a/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp b/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
index 626c5f6d7a..a05d2a839a 100644
--- a/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
+++ b/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
@@ -158,7 +158,7 @@ void XDLauncherDialog::CreateMainLayout()
   };
   add_row(&m_game_row, tr("Pokémon XD (USA) — choose your XD ISO file"), tr("Choose ISO..."));
   add_row(&m_rom_row, tr("Emerald ROM configured"), tr("Choose ROM..."));
-  add_row(&m_bios_row, tr("GBA BIOS (optional)"), tr("Choose BIOS..."));
+  add_row(&m_bios_row, tr("Official GBA BIOS"), tr("Choose BIOS..."));
   add_row(&m_team_saves_row, tr("Team saves installed"), tr("Install"));
   add_row(&m_vs_save_row, tr("XD VS-mode save (memory card)"), tr("Install"));
   add_row(&m_gba_input_row, tr("GBA controls"), tr("Use defaults"));
@@ -254,14 +254,17 @@ void XDLauncherDialog::RefreshChecklist()
 
   SetRowState(m_game_row.status, FindXdGame() != nullptr);
   SetRowState(m_rom_row.status, EmeraldRomConfigured());
-  // Not a requirement any more: with no BIOS file the GBA boots on mGBA's
-  // built-in HLE BIOS, which XD detects (and which boots faster than a real
-  // dump). An official dump is still honoured if the user has one.
+  // Required, and settled the hard way: the official dump is the only BIOS the
+  // game will accept. Its boot code contains Nintendo's own JoyBus listener,
+  // which is what answers the GameCube's handshake -- no open-source BIOS
+  // reimplements it, and mGBA's HLE BIOS does not either. Tested on device:
+  // the old bundled build, a current Cult-of-GBA build and HLE all leave the
+  // link window opening while the handshake never starts.
   const bool official_bios = XDNetplay::CheckOfficialBios(nullptr);
-  SetRowState(m_bios_row.status, true);
+  SetRowState(m_bios_row.status, official_bios);
   m_bios_row.description->setText(
-      official_bios ? tr("GBA BIOS: using your official dump") :
-                      tr("GBA BIOS: none needed — booting without one (optional)"));
+      official_bios ? tr("Official GBA BIOS configured") :
+                      tr("Official GBA BIOS required — the game cannot detect the GBA without it"));
   SetRowState(m_team_saves_row.status, TeamSavesInstalled());
   SetRowState(m_vs_save_row.status, VsSaveInstalled());
   const bool input_mapped = XDNetplay::GbaInputMapped();

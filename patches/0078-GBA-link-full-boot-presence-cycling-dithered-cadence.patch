@@ -412,6 +412,10 @@ const Info<bool> MAIN_GBA_PRACTICE_DUMMY{{System::Main, "GBA", "PracticeDummy"},
 // Debounced falling-edge GBA auto-reset (fast fresh-boot-window cadence for

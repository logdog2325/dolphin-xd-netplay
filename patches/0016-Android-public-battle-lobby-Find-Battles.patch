 .../features/xdnetplay/ui/XDLauncherActivity.kt          | 1 +
 .../dolphinemu/features/xdnetplay/ui/XDLauncherScreen.kt | 9 +++++++++
 Source/Android/jni/CMakeLists.txt                        | 1 +
 4 files changed, 16 insertions(+)


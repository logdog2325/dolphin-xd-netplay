 .../app/src/main/res/values/strings.xml       |   2 +-
 .../app/src/main/res/values/xd_colors.xml     |   2 +-
 .../DolphinQt/XDNetplay/PokemonHubDialog.cpp  |   2 +-
 .../DolphinQt/XDNetplay/TeamEditorDialog.cpp  |   2 +-

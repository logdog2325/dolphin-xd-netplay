From cdabdfd6ac04ab17fb912c79cbda071b54bffc22 Mon Sep 17 00:00:00 2001
From: logdog2325 <loganjayfisher@gmail.com>
Date: Mon, 31 Aug 2026 17:18:51 -0700
Subject: [PATCH] Kill the preview mugshots at their real source

Field result on 1.5.3, with the full hide block verified in the device log:
the preview faces STILL drew, and each side showed different art (the
default trainer for one side, May for the other) -- proof of a per-side
dynamic path none of the previous patches touch.

The real drawer, pinned by disassembly: the preview screen's element
dispatcher has a per-slot case (element ids 0x419/0x446/0x473/0x4A0) that
re-images its element EVERY FRAME -- it reads the side's art index from the
VS slot struct, picks from the flat 19-entry art table (5 empty-side
plates + all 14 busts), and calls SetElementImage, which sizes from the
chosen entry's language-variant W/H. That is why the earlier fixes missed:
the panel kills cover a different element, and a session's variant zeroes
only cover the classes IT hides while the dynamic pick can reach any of
the 19 entries.

The kill: four 32-bit writes retarget those cases' jump-table words
(0x803C5E34 + (id-1018)*4) at the dispatcher's own bare-epilogue no-op
0x8007227C. The table is compiler switch data with no writer anywhere in
the DOL (and the old case target appears exactly four times in the whole
binary -- the kill is complete), so nothing can race or fight it. The
element keeps its static record image, the vanilla 68x24 empty-side plate,
so the corner looks exactly like a side with no save; mon pictures, party
icons, names and the connection screen's bust handling are untouched.
Same trigger as the rest of the hide set: any format session, or a
portrait-less pick.
---
 .../UICommon/XDNetplay/BattleCustomizer.cpp   | 23 +++++++++++++++++++
 Source/Core/UICommon/XDNetplay/Version.h      |  2 +-
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp b/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp
index 7d2bf4d..8272ee4 100644
--- a/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp
+++ b/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp
@@ -177,6 +177,27 @@ constexpr u32 PreviewPanelWhAddr(u32 record)
 constexpr u32 PREVIEW_PANEL_IMG_TYPE_LINE = 0x0030AC60;  // 8-bit write @ 0x8030AC60
 constexpr u32 PREVIEW_PANEL_IMG_TYPE_VALUE = 0x00000080;  // type bits cleared, bit7 kept
 
+// THE path that actually draws the preview mugshots (found third, the hard
+// way): dispatcher case 31 of the preview screen's element engine -- element
+// ids 0x419/0x446/0x473/0x4A0, one per player-slot corner -- re-images its
+// element EVERY FRAME (0x8007214C: reads the side's art index from the VS
+// slot struct +0x1A, indexes the flat 19-entry art table 0x802EB670 = 5
+// empty-side plates + 7 small busts + 7 large busts, then SetElementImage
+// 0x80049EA4, which sizes from the chosen entry's LANGUAGE-VARIANT W/H).
+// That is why every earlier patch missed: the record/panel kills cover a
+// different element, and the variant zeroes only cover the classes a given
+// session hides -- the dynamic pick reaches any of the 19 entries. The kill
+// is the dispatcher's own jump table (0x803C5E34 + (id-1018)*4): retarget
+// the four cases at the engine's bare-epilogue no-op 0x8007227C. The table
+// is compiler switch data with NO writer anywhere in the DOL (verified), so
+// the patch cannot be raced by the menu-fsys record reload. Post-patch the
+// element keeps its STATIC record image -- the vanilla 68x24 empty-side
+// plate -- so the corner shows exactly what an empty side shows, and no
+// path to bust art exists on this screen. Originals: all four words are
+// 0x8007214C (restore value).
+constexpr u32 PREVIEW_FACE_CASE_LINES[4] = {0x043C5EB0, 0x043C5F64, 0x043C6018, 0x043C60CC};
+constexpr u32 PREVIEW_FACE_CASE_NOOP = 0x8007227C;
+
 // Model id -> bust class (1 FRLG-m, 2 FRLG-f, 3 RS-m, 4 RS-f, 5 E-m, 6 E-f).
 // Only the six GBA player models have bust widgets in the connection menu;
 // anything else returns 0 = no bust remap (battle model still changes).
@@ -747,6 +768,8 @@ std::string GenerateCodeBlock(std::optional<int> p1_model, std::optional<int> p2
       for (const u32 record : PREVIEW_TRAINER_PANEL_RECORDS)
         AppendLine(&block, PreviewPanelWhAddr(record), 0x00010000);
       AppendLine(&block, PREVIEW_PANEL_IMG_TYPE_LINE, PREVIEW_PANEL_IMG_TYPE_VALUE);
+      for (const u32 line : PREVIEW_FACE_CASE_LINES)
+        AppendLine(&block, line, PREVIEW_FACE_CASE_NOOP);
     }
   }
   if (music)
diff --git a/Source/Core/UICommon/XDNetplay/Version.h b/Source/Core/UICommon/XDNetplay/Version.h
index d7b1b20..b961721 100644
--- a/Source/Core/UICommon/XDNetplay/Version.h
+++ b/Source/Core/UICommon/XDNetplay/Version.h
@@ -11,5 +11,5 @@ namespace XDNetplay
 // fork's release, so it cannot answer "which XD Netplay am I?" -- this constant is the only thing
 // that can. It MUST be bumped in the same patch that a release is tagged from: ship a tag ahead of
 // this string and every user of that release is told they are out of date forever.
-constexpr char VERSION[] = "1.5.3";
+constexpr char VERSION[] = "1.5.4";
 }  // namespace XDNetplay

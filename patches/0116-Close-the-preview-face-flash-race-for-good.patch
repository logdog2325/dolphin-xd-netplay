From bbb2004b3075cedf740cebb26d73a5b63c215e6a Mon Sep 17 00:00:00 2001
From: logdog2325 <loganjayfisher@gmail.com>
Date: Mon, 31 Aug 2026 00:24:57 -0700
Subject: [PATCH] Close the preview-face flash race for good

Field result on 1.5.2: the trainer faces still FLASHED briefly when the
team-preview screen appeared, then went dark. Root cause (traced through
the element engine): screen elements COPY their static records once at
construction, and the game RELOADS the record bank from the menu fsys at
battle-mode entry -- a screen build that lands in the same frame as that
reload copies the restored 306x168 before the once-per-frame AR write
reapplies. No per-frame poke of the records can close that window.

The race-immune kill is one byte in the panels' IMAGE ENTRY (img-entry
table at 0x803001A8, entry 0x25F at 0x8030AC60), which no code ever
rewrites at runtime: clearing byte0's type bits (0x90 -> 0x80, chain
terminator bit preserved) makes construction match no image-type branch,
so the element's draw flag is never set and nothing is emitted for it,
whatever the raced records contain. Type-0 entries are a natively
supported state, and the four panel records are the entry's only
consumers.

Zeroing the entry's texture keys instead was proven WRONG in verification:
the renderer's null-texture guard skips only the bind and UV math, then
still emits the full quad sampling whatever texture the previous element
left bound -- and a zero key can even match a genuine key-0 registration.

Also raises the GBA detect log's pre-boot note ring from 32 to 160 lines:
one Battle Style regenerate emits ~60 lines and the ring was evicting the
block head, which is exactly what field debugging needs to see.
---
 Source/Core/Core/HW/GBADetectLog.cpp          |  6 ++++-
 .../UICommon/XDNetplay/BattleCustomizer.cpp   | 24 ++++++++++++++++++-
 Source/Core/UICommon/XDNetplay/Version.h      |  2 +-
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/Source/Core/Core/HW/GBADetectLog.cpp b/Source/Core/Core/HW/GBADetectLog.cpp
index 17f68d2..2401160 100644
--- a/Source/Core/Core/HW/GBADetectLog.cpp
+++ b/Source/Core/Core/HW/GBADetectLog.cpp
@@ -37,7 +37,11 @@ int s_live_devices = 0;  // ref-count -> session begin/end
 // Bounded: a user flipping dropdowns for an hour without booting must not
 // grow this without limit -- older notes fall off, the freshest state wins.
 std::vector<std::string> s_boot_notes;
-constexpr size_t MAX_BOOT_NOTES = 32;
+constexpr size_t MAX_BOOT_NOTES = 160;  // raised from 32: one Battle Style
+// regenerate emits ~60 lines (guard + models + bust/panel hides + menu pins +
+// 36 ruleset words) and the ring was evicting the block's HEAD, which is
+// exactly the part field debugging needs (the 1.5.2 preview-flash session
+// could not show whether the hide lines shipped).
 // Atomic so every Log* can early-out lock-free and stop FORMATTING once capped
 // (Review #1 I5: the byte cap must bound CPU/lock cost, not just disk).
 std::atomic<bool> s_capped{false};
diff --git a/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp b/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp
index a7ed7a0..7d2bf4d 100644
--- a/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp
+++ b/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp
@@ -156,6 +156,26 @@ constexpr u32 PreviewPanelWhAddr(u32 record)
 {
   return 0x02000000u | ((record + 0x12) & 0x01FFFFFFu);  // 16-bit write at &w
 }
+// The record w/h zeroing above CANNOT close the brief flash on its own: the
+// game RELOADS the record bank from the menu fsys at battle-mode entry and
+// can build the screen in that same frame, before the once-per-frame AR
+// write reapplies -- a build that races the reload copies the restored
+// 306x168 and the face shows until the next rebuild. The race-immune kill is
+// one byte in the IMG ENTRY for the panels' image (entry 0x25F of the
+// 72-byte img-entry table at 0x803001A8; entry base 0x8030AC60): clearing
+// byte0's type bits (stock 0x90 -> 0x80, bit7 = chain-terminator preserved)
+// makes screen CONSTRUCTION match no image-type branch, so the element's
+// draw flag is never set and nothing is ever emitted for it -- independent
+// of whatever the raced records contain. Verified: the entry table has no
+// runtime writer anywhere in the DOL (patches to it cannot lose a reload
+// race), the four panel records are the only consumers of entry 0x25F, and
+// type-0 entries are a natively supported state (entry 0 ships as 0x80).
+// (Zeroing the entry's texkeys instead was PROVEN WRONG: the renderer's
+// null-texture guard only skips the texture BIND and UV math, then still
+// emits the 306x168 quad sampling whatever texture the previous element
+// left bound -- and texkey 0 can even match a genuine key-0 registration.)
+constexpr u32 PREVIEW_PANEL_IMG_TYPE_LINE = 0x0030AC60;  // 8-bit write @ 0x8030AC60
+constexpr u32 PREVIEW_PANEL_IMG_TYPE_VALUE = 0x00000080;  // type bits cleared, bit7 kept
 
 // Model id -> bust class (1 FRLG-m, 2 FRLG-f, 3 RS-m, 4 RS-f, 5 E-m, 6 E-f).
 // Only the six GBA player models have bust widgets in the connection menu;
@@ -722,9 +742,11 @@ std::string GenerateCodeBlock(std::optional<int> p1_model, std::optional<int> p2
       // Same trigger, different screen: blank the pick/preview screen's four
       // trainer-picture panels (see PREVIEW_TRAINER_PANEL_RECORDS). Value:
       // repeat count 1 in the high half makes the one 16-bit write cover both
-      // w (+0x12) and h (+0x14).
+      // w (+0x12) and h (+0x14). Steady-state only -- the reload race is
+      // closed by the img-entry type byte below.
       for (const u32 record : PREVIEW_TRAINER_PANEL_RECORDS)
         AppendLine(&block, PreviewPanelWhAddr(record), 0x00010000);
+      AppendLine(&block, PREVIEW_PANEL_IMG_TYPE_LINE, PREVIEW_PANEL_IMG_TYPE_VALUE);
     }
   }
   if (music)
diff --git a/Source/Core/UICommon/XDNetplay/Version.h b/Source/Core/UICommon/XDNetplay/Version.h
index 2e9c7c0..d7b1b20 100644
--- a/Source/Core/UICommon/XDNetplay/Version.h
+++ b/Source/Core/UICommon/XDNetplay/Version.h
@@ -11,5 +11,5 @@ namespace XDNetplay
 // fork's release, so it cannot answer "which XD Netplay am I?" -- this constant is the only thing
 // that can. It MUST be bumped in the same patch that a release is tagged from: ship a tag ahead of
 // this string and every user of that release is told they are out of date forever.
-constexpr char VERSION[] = "1.5.2";
+constexpr char VERSION[] = "1.5.3";
 }  // namespace XDNetplay

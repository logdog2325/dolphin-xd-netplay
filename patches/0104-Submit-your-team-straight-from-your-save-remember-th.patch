+std::string ResolveGuestSavePath(int device, std::string* error)
+{
+  std::string rom = Config::Get(Config::MAIN_GBA_ROM_PATHS[device]);
+  if (rom.empty() || !File::Exists(rom))
+    rom = Config::Get(Config::MAIN_GBA_ROM_PATHS[device == 1 ? 2 : 1]);
